# C2AI backend configuration. Copy to backend/.env and fill in.
# Never commit the real .env; keep production values in your secret store.
#
# Every variable is read once through c2ai/config.py (typed, validated at
# startup). Process environment variables override this file; point at another
# file with C2AI_ENV_FILE=/path/to/env. Empty values fall back to the default.

# --- Server ---------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8007
# Comma-separated browser origins allowed to call the API (Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Serve the built UI (frontend/dist) from the API process.
C2AI_SERVE_FRONTEND=true
# C2AI_FRONTEND_DIST=/absolute/path/to/frontend/dist
# Run the background job worker inside the API process. Set false on API
# replicas when a separate `python -m c2ai.worker` process runs the jobs.
C2AI_RUN_WORKER=true
# C2AI_WORKER_POLL_SECONDS=1

# --- Database -------------------------------------------------------------
# Used by the API, `python -m c2ai.db.migrate` and `python -m c2ai.db.init_db`.
# (LOCAL_DATABASE_URL is still accepted for existing Athena environments.)
DATABASE_URL=postgresql+asyncpg://c2ai:change-me@localhost:5432/c2ai
# Password for the seeded `admin` account (init_db only).
C2AI_ADMIN_PASSWORD=admin

# --- Authentication -------------------------------------------------------
# Generate with: python -m c2ai.auth.generate_secret
ATHENA_AUTH_SECRET=
# Session length for a login, and the upper bound a client may request.
ATHENA_TOKEN_TTL_SECONDS=604800
ATHENA_TOKEN_MAX_TTL_SECONDS=2592000
ATHENA_COOKIE_SAMESITE=lax
# true in production behind HTTPS (forced when SameSite=none).
ATHENA_COOKIE_SECURE=
ATHENA_AUTH_COOKIE_DOMAIN=
ATHENA_AUTH_COOKIE_NAME=access_token

# --- Credential storage ---------------------------------------------------
# pgcrypto key for GitHub tokens, registry passwords and LLM API tokens.
ATHENA_CREDENTIAL_ENCRYPTION_KEY=

# --- GitHub / deployment pipelines -----------------------------------------
# Token for Amberd's predefined workflows (ADA deploy/update/terminate,
# container pipelines, GitHub-app upgrade/terminate). Needs Actions read+write.
GITHUB_PAT=
GITHUB_REPO_OWNER=amberd-ai
GITHUB_REPO_NAME=devops
DEVOPS_BRANCH=main
# Repository whose branches/tags the legacy ADA deploy form offers.
DEPLOY_SOURCE_REPO=dealership_new
# Repository owners whose workflows declare the `slack_user` input.
SLACK_USER_DEFAULT_REPO_OWNERS=amberd-ai
# Container pipelines (defaults shown).
CONTAINER_DEPLOYMENT_REPOSITORY=amberd-ai/devops
CONTAINER_DEPLOYMENT_WORKFLOW=containerized-app-deploy.yaml
CONTAINER_DEPLOYMENT_EVENT_TYPE=containerized-deploy
CONTAINER_UPGRADE_REPOSITORY=amberd-ai/devops
CONTAINER_UPGRADE_WORKFLOW=containerized-app-update.yaml
CONTAINER_TERMINATION_REPOSITORY=amberd-ai/devops
CONTAINER_TERMINATION_WORKFLOW=containerized-app-terminate.yaml
# Where pipelines post progress (POST /api/registered-applications/deployments/{id}/progress)
ATHENA_CALLBACK_BASE_URL=https://athena.amberd.ai
# Shared secret pipelines send in X-Athena-Deployment-Token.
DEPLOYMENT_CALLBACK_TOKEN=
# Domain for instance /version lookups on the tier dashboard.
ATHENA_INSTANCE_DOMAIN=amberd.ai

# --- Container registries & managed secrets --------------------------------
DOCKER_HUB_API_URL=https://hub.docker.com
REGISTRY_CREDENTIAL_PROVIDER_URL=
REGISTRY_CREDENTIAL_PROVIDER_TOKEN=
CONTAINER_SECRET_PROVIDER_URL=
CONTAINER_SECRET_PROVIDER_TOKEN=

# --- Grafana (Prometheus metrics + Loki logs) -------------------------------
GRAFANA_API_URL=https://grafana.example.com/api/ds/query
GRAFANA_API_TOKEN=
GRAFANA_PROMETHEUS_DATASOURCE_UID=prometheus
GRAFANA_LOKI_DATASOURCE_UID=
GRAFANA_LOKI_MAX_LINES=2000
GRAFANA_LOKI_NAMESPACE_LABEL=namespace
GRAFANA_LOKI_DEPLOYMENT_LABEL=deployment
GRAFANA_LOKI_TIER_LABEL=
ATHENA_SCRAPE_INTERVAL_SECONDS=60
ATHENA_CPU_CORES_CAP=8
ATHENA_MEMORY_GB_CAP=80
ATHENA_EXCLUDED_DEPLOYMENTS=nginx
# Per-tier overrides (defaults in c2ai/constants/prometheus.py):
# ATHENA_TIER1_LABEL_REGEX=tier1
# ATHENA_TIER1_GPU_CLUSTER=qwen-5254d

# --- Cost tracking ----------------------------------------------------------
ATHENA_FINANCIAL_INGESTION_ENABLED=true
ATHENA_FINANCIAL_POLL_SECONDS=3600
# Minimum window before a poll advances the checkpoint (>= 2x scrape interval).
# ATHENA_FINANCIAL_MIN_WINDOW_SECONDS=900

# --- Troubleshooting LLM (vLLM, OpenAI-compatible) --------------------------
VLLM_ENDPOINT=
VLLM_QWEN3_6_ENDPOINT=
VLLM_API_KEY=

# --- User management ----------------------------------------------------------
PASSWORD_LENGTH=10
PASSWORD_SPECIALS=!@#$%^&*()_+-
IDENTIFIER_MIN_LENGTH=3
IDENTIFIER_MAX_LENGTH=30
